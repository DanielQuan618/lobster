# Gradle files
.gradle/
build/

# 本机 APK 交付目录（一键门禁把最新产物复制到仓库根 apk/，永不入库）
/apk/

# Local configuration file (sdk path, signing passwords)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files（签名密钥不随仓库分发，密码在 local.properties）
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# python pyc
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# ==== 版权物：仅保留在本地工作区，不随 git 仓库分发 ====
# 桔库开局库（第三方版权内容；缺失时连线自动降级为纯引擎模式）
app/src/main/assets/databases/

# ONNX 识别模型（体积大不入库；使用前自行放置，见 assets/models/README.md）
app/src/main/assets/models/*.onnx
